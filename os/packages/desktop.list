# NoCap Desktop: what the server's own screen runs (labwc + NoCap Shell).
# Same format as common.list. Only the libraries and services NoCap Shell's
# own programs use: no third-party apps (no file manager, terminal, editor,
# image viewer, browser or games). NoCap's own desktop apps come from the
# nocap-shell / nocap-desktop packages.

labwc                      # NoCap Desktop's compositor
greetd                     # NoCap Desktop's sign-in screen
xwayland                   # older (X11) apps on NoCap Desktop
wayvnc                     # this screen in the browser (Remote view)
swayidle                   # screen blanking and lock on idle
libgtk-3-0t64|libgtk-3-0   # NoCap Shell's programs (GTK 3)
libgtk-layer-shell0        # NoCap Shell's top bar, dock and launcher
libwebkit2gtk-4.1-0        # NoCap Shell's web views and the installer screen
libjson-glib-1.0-0         # NoCap Shell talks to NoCapOS (JSON)
libpolkit-agent-1-0        # NoCap Shell's password prompts
libxkbcommon0              # keyboard layouts
libpangocairo-1.0-0        # text drawing in NoCap Shell
libgdk-pixbuf-2.0-0|libgdk-pixbuf2.0-0 # images in NoCap Shell
polkitd                    # admin prompts on NoCap Desktop
xdg-desktop-portal-wlr     # screen sharing and screenshots for apps
xdg-desktop-portal-gtk     # file pickers for Flatpak apps
xdg-user-dirs              # Desktop, Downloads, Pictures folders for each account
gnome-keyring              # saved passwords for apps
libpam-gnome-keyring       # unlocks saved passwords at sign-in
dbus-user-session          # per-account session bus
pipewire                   # sound and screen sharing
wireplumber                # sound device handling
?pipewire-pulse            # sound for apps that speak PulseAudio
?grim                      # screenshots
?libnotify-bin             # notifications from scripts
?brightnessctl             # brightness keys on laptops
adwaita-icon-theme         # icons for GTK apps
fonts-dejavu-core          # default fonts
?fonts-cantarell           # NoCap Shell's UI font fallback
?libsecret-tools           # saved passwords from scripts
libgl1-mesa-dri            # GPU drivers (and the software renderer for VMs)
libegl-mesa0               # GPU drivers for Wayland
libgbm1                    # GPU buffers for the compositor
?wl-clipboard              # shared clipboard with the browser (wl-paste)
?xclip                     # shared clipboard for X11 apps
?systemd-zram-generator    # compressed swap in RAM on small boards
