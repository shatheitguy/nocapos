[Unit]
Description=NoCapOS: watch this machine's settings for changes
Documentation=https://github.com/shatheitguy/nocapos/blob/main/os/README.md

[Path]
PathChanged=/etc/passwd
PathChanged=/etc/group
PathChanged=/etc/shadow
PathChanged=/etc/gshadow
PathChanged=/etc/hostname
PathChanged=/etc/hosts
PathChanged=/etc/timezone
PathChanged=/etc/localtime
PathChanged=/etc/fstab
PathChanged=/etc/environment
PathChanged=/etc/default/keyboard
PathChanged=/etc/default/locale
PathChanged=/etc/samba/smb.conf
PathChanged=/etc/zfs/zpool.cache
PathChanged=/etc/NetworkManager/system-connections
PathChanged=/etc/ufw
PathChanged=/etc/greetd
PathChanged=/etc/nocapos
PathChanged=/etc/sudoers.d
PathChanged=/etc/systemd/system
PathChanged=/etc/avahi/services
PathChanged=/etc/libvirt/qemu
TriggerLimitIntervalSec=10s
TriggerLimitBurst=5
Unit=nocapos-etc-changed.service

[Install]
WantedBy=paths.target
