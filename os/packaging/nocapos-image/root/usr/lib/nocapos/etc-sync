#!/bin/sh
# etc-sync: keeps this machine's own settings in /etc across restarts and
# system updates on a NoCapOS image install.
#
# The system (and its /etc) is read-only and replaced whole by every update;
# changes to /etc live in a scratch overlay that starts fresh at each boot.
# The settings below are copied to the data partition when they change
# ("save") and copied back before anything else starts ("restore", run by
# Rugix as a boot/post-init hook, before systemd). Copies, not bind mounts:
# tools replace these files by renaming a new file over them, which a bind
# mount would refuse.
#
# Accounts (passwd, group, shadow, gshadow) are merged: the system accounts
# come from the running image (so an update can add one), the people's
# accounts (UID/GID 1000-59999) and their group memberships from the saved
# copy.
#
#   etc-sync restore | save | list
set -eu

STORE="${NOCAP_ETC_STORE:-/var/lib/nocapos-system/etc}"
ETC="${NOCAP_ETC_ROOT:-/etc}"

# Single files (relative to /etc). localtime is a symlink and saved as one.
FILES="hostname hosts timezone localtime default/keyboard default/locale
locale.conf vconsole.conf fstab environment zfs/zpool.cache
samba/smb.conf nocapos/nocapos.env nocapos/desktop.conf nocapos/desktop-mode
subuid subgid"

# Whole folders: the saved copy replaces the image's.
DIRS="NetworkManager/system-connections NetworkManager/nocap-certs ufw/user-rules
greetd sudoers.d systemd/system avahi/services libvirt/qemu libvirt/storage
libvirt/secrets ssh nocapos/conf.d wireguard"

# ufw keeps its rules in several files next to its defaults.
UFW_FILES="ufw/user.rules ufw/user6.rules ufw/ufw.conf default/ufw"

ACCOUNTS="passwd group shadow gshadow"

# Logged to the kernel log too: at boot this runs before the journal.
log() {
  echo "nocapos etc-sync: $*" >&2
  if [ -w /dev/kmsg ]; then echo "nocapos etc-sync: $*" >/dev/kmsg 2>/dev/null || true; fi
}

# ---- accounts ------------------------------------------------------------

# merge_passwd IMAGE SAVED: image lines, then saved lines whose UID is a
# person's (1000-59999) and whose name the image doesn't have.
merge_passwd() {
  awk -F: 'FNR == NR { seen[$1] = 1; print; next }
           ($3 >= 1000 && $3 < 60000 && !($1 in seen)) { print }' "$1" "$2"
}

# merge_group IMAGE SAVED PASSWD: image groups with members the saved copy
# added (people only), then saved groups with a person's GID.
merge_group() {
  awk -F: -v OFS=: '
    FILENAME == ARGV[1] { if ($3 >= 1000 && $3 < 60000) person[$1] = 1; next }
    FILENAME == ARGV[2] { saved[$1] = $4; sline[$1] = $0; sgid[$1] = $3; next }
    {
      names[$1] = 1
      n = split($4, m, ","); delete have
      out = $4
      for (i = 1; i <= n; i++) if (m[i] != "") have[m[i]] = 1
      if ($1 in saved) {
        k = split(saved[$1], s, ",")
        for (i = 1; i <= k; i++) if (s[i] != "" && (s[i] in person) && !(s[i] in have)) {
          out = (out == "" ? s[i] : out "," s[i]); have[s[i]] = 1
        }
      }
      $4 = out; print
    }
    END {
      for (g in sline) if (!(g in names) && sgid[g] >= 1000 && sgid[g] < 60000) print sline[g]
    }' "$3" "$2" "$1"
}

# merge_shadow IMAGE SAVED PASSWD: image entries, then saved entries of the
# people in the merged passwd.
merge_shadow() {
  awk -F: '
    FILENAME == ARGV[1] { if ($3 >= 1000 && $3 < 60000) person[$1] = 1; next }
    FILENAME == ARGV[2] { seen[$1] = 1; print; next }
    (($1 in person) && !($1 in seen)) { print }' "$3" "$1" "$2"
}

# merge_gshadow IMAGE SAVED GROUP: image entries (members from the merged
# group file), then saved entries for the people's own groups.
merge_gshadow() {
  awk -F: -v OFS=: '
    FILENAME == ARGV[1] { members[$1] = $4; gid[$1] = $3; next }
    FILENAME == ARGV[2] { saved[$1] = $0; next }
    { seen[$1] = 1; if ($1 in members) $4 = members[$1]; print }
    END {
      for (g in saved) if (!(g in seen) && (g in gid) && gid[g] >= 1000 && gid[g] < 60000) print saved[g]
    }' "$3" "$2" "$1"
}

restore_accounts() {
  [ -f "$STORE/passwd" ] || return 0
  tmp="$(mktemp -d)"
  for f in $ACCOUNTS; do
    if [ -f "$ETC/$f" ]; then cp -p "$ETC/$f" "$tmp/$f.image"; else : >"$tmp/$f.image"; fi
    if [ -f "$STORE/$f" ]; then cp "$STORE/$f" "$tmp/$f.saved"; else : >"$tmp/$f.saved"; fi
  done
  merge_passwd "$tmp/passwd.image" "$tmp/passwd.saved" >"$tmp/passwd"
  merge_group "$tmp/group.image" "$tmp/group.saved" "$tmp/passwd" >"$tmp/group"
  merge_shadow "$tmp/shadow.image" "$tmp/shadow.saved" "$tmp/passwd" >"$tmp/shadow"
  merge_gshadow "$tmp/gshadow.image" "$tmp/gshadow.saved" "$tmp/group" >"$tmp/gshadow"
  for f in $ACCOUNTS; do
    if [ -s "$tmp/$f" ] || [ "$f" = gshadow ]; then
      if [ "$(id -u)" = 0 ]; then
        install -m "$(account_mode "$f")" -o root -g "$(account_group "$f")" "$tmp/$f" "$ETC/$f"
      else
        install -m "$(account_mode "$f")" "$tmp/$f" "$ETC/$f"
      fi
    fi
  done
  rm -rf "$tmp"
}

account_mode() { case "$1" in shadow | gshadow) echo 640 ;; *) echo 644 ;; esac; }
account_group() {
  case "$1" in
    shadow | gshadow) getent_group shadow ;;
    *) echo root ;;
  esac
}
getent_group() { if grep -q "^$1:" "$ETC/group" 2>/dev/null; then echo "$1"; else echo root; fi; }

# ---- files and folders ---------------------------------------------------

restore() {
  # /etc starts fresh at every boot: this marks "done for this boot".
  : >"$ETC/.nocapos-etc-restored" 2>/dev/null || true
  [ -d "$STORE" ] || { log "nothing saved yet (first start)"; return 0; }
  restore_accounts
  for f in $FILES $UFW_FILES; do
    src="$STORE/files/$f"
    if [ -L "$src" ]; then
      mkdir -p "$(dirname "$ETC/$f")"
      rm -f "$ETC/$f"
      ln -s "$(readlink "$src")" "$ETC/$f"
    elif [ -f "$src" ]; then
      mkdir -p "$(dirname "$ETC/$f")"
      rm -f "$ETC/$f"
      cp -p "$src" "$ETC/$f"
    elif [ -e "$STORE/files/$f.absent" ]; then
      rm -f "$ETC/$f"
    fi
  done
  for d in $DIRS; do
    src="$STORE/dirs/$d"
    [ -d "$src" ] || continue
    rm -rf "${ETC:?}/$d"
    mkdir -p "$(dirname "$ETC/$d")"
    cp -a "$src" "$ETC/$d"
  done
  log "restored this machine's settings from $STORE"
}

save_file() {
  f="$1"
  dst="$STORE/files/$f"
  mkdir -p "$(dirname "$dst")"
  if [ -L "$ETC/$f" ]; then
    rm -f "$dst.new"
    ln -s "$(readlink "$ETC/$f")" "$dst.new"
    mv -Tf "$dst.new" "$dst"
    rm -f "$dst.absent"
  elif [ -f "$ETC/$f" ]; then
    cp -p "$ETC/$f" "$dst.new"
    mv -f "$dst.new" "$dst"
    rm -f "$dst.absent"
  elif [ -e "$dst" ]; then
    # Removed on purpose since the last save.
    rm -f "$dst"
    : >"$dst.absent"
  fi
}

save() {
  umask 077
  mkdir -p "$STORE/files" "$STORE/dirs"
  chmod 700 "$STORE"
  for f in $ACCOUNTS; do
    [ -f "$ETC/$f" ] || continue
    cp -p "$ETC/$f" "$STORE/$f.new"
    mv -f "$STORE/$f.new" "$STORE/$f"
  done
  for f in $FILES $UFW_FILES; do save_file "$f"; done
  for d in $DIRS; do
    dst="$STORE/dirs/$d"
    if [ -d "$ETC/$d" ]; then
      mkdir -p "$(dirname "$dst")"
      rm -rf "$dst.new"
      cp -a "$ETC/$d" "$dst.new"
      rm -rf "$dst.old"
      [ -d "$dst" ] && mv "$dst" "$dst.old"
      mv "$dst.new" "$dst"
      rm -rf "$dst.old"
    else
      rm -rf "$dst"
    fi
  done
  sync -f "$STORE" 2>/dev/null || sync
}

case "${1:-}" in
  restore) restore ;;
  save) save ;;
  list) for f in $ACCOUNTS $FILES $UFW_FILES; do echo "$ETC/$f"; done; for d in $DIRS; do echo "$ETC/$d/"; done ;;
  *) echo "usage: etc-sync restore|save|list" >&2; exit 2 ;;
esac
