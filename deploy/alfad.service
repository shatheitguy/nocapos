[Unit]
Description=Alfa OS daemon (alfad)
Documentation=https://github.com/alfaos/alfaos
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=alfa
Group=alfa
EnvironmentFile=/etc/alfaos/alfad.env
ExecStart=/usr/local/bin/alfad serve
Restart=on-failure
RestartSec=3

# Bind 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandbox: read-only OS, private /tmp, no privilege escalation. alfad reads
# /proc and /sys for telemetry; it only writes its data and storage folders.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# No PrivateDevices: nvidia-smi needs /dev/nvidia* for GPU metrics.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0027
StateDirectory=alfaos
# "-": don't fail if missing; install.sh adds the configured storage path in a drop-in.
ReadWritePaths=-/srv/alfaos

[Install]
WantedBy=multi-user.target
