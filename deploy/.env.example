# Group owning the Docker socket on the host: stat -c %g /var/run/docker.sock
# Docker Desktop (Windows/macOS): 0
DOCKER_GID=999

# Rootless Docker: /run/user/<uid>/docker.sock
DOCKER_SOCK=/var/run/docker.sock

ALFA_VERSION=dev
ALFA_HTTP_PORT=80
ALFA_HTTPS_PORT=443
ALFA_LOG_LEVEL=info

# Optional: fixed first-run setup token (otherwise one is generated and logged).
ALFA_SETUP_TOKEN=

# Extra WebSocket origins, comma separated (same-host origins are always allowed).
ALFA_ALLOWED_ORIGINS=

# Pin images by digest in production.
TRAEFIK_IMAGE=traefik:v3.5
SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:latest
