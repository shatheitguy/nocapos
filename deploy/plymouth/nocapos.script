# NoCapOS boot splash (Plymouth script theme): the logo centred on near-black
# with a slow red glow, three loading dots and a thin progress bar.

Window.SetBackgroundTopColor(0.02, 0.02, 0.03);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.03);

sw = Window.GetWidth();
sh = Window.GetHeight();
short = Math.Min(sw, sh);

# ---- logo + glow
logo_img = Image("logo.png");
size = Math.Int(short * 0.28);
if (size > 256) size = 256;
if (size < 96) size = 96;
logo_img = logo_img.Scale(size, size);
logo = Sprite(logo_img);
lx = Math.Int(Window.GetX() + sw / 2 - size / 2);
ly = Math.Int(Window.GetY() + sh / 2 - size / 2 - short * 0.05);
logo.SetPosition(lx, ly, 10);

glow_size = Math.Int(size * 1.5);
glow_img = Image("glow.png").Scale(glow_size, glow_size);
glow = Sprite(glow_img);
glow.SetPosition(Math.Int(lx + size / 2 - glow_size / 2), Math.Int(ly + size / 2 - glow_size / 2), 5);

# ---- loading dots
dot_img = Image("dot.png");
gap = 22;
dots_y = Math.Int(ly + size + short * 0.06);
for (i = 0; i < 3; i++) {
  dot[i] = Sprite(dot_img);
  dot[i].SetPosition(Math.Int(Window.GetX() + sw / 2 - gap + i * gap - dot_img.GetWidth() / 2), dots_y, 10);
  dot[i].SetOpacity(0.25);
}

# ---- progress bar (fed by Plymouth's boot progress)
bar_w = Math.Int(short * 0.32);
if (bar_w < 160) bar_w = 160;
bar_h = 4;
bar_x = Math.Int(Window.GetX() + sw / 2 - bar_w / 2);
bar_y = dots_y + 34;
track = Sprite(Image("track.png").Scale(bar_w, bar_h));
track.SetPosition(bar_x, bar_y, 9);
fill_src = Image("fill.png");
fill = Sprite();
fill.SetPosition(bar_x, bar_y, 10);
shown = 0;

fun progress_cb(duration, progress) {
  if (progress > shown) shown = progress;
  w = Math.Int(bar_w * shown);
  if (w < 1) w = 1;
  fill.SetImage(fill_src.Scale(w, bar_h));
}
Plymouth.SetBootProgressFunction(progress_cb);

# ---- animation: the glow breathes, the dots run a wave
t = 0;
fun refresh_cb() {
  t++;
  glow.SetOpacity(0.55 + 0.35 * Math.Sin(t / 30));
  for (i = 0; i < 3; i++) {
    a = Math.Sin(t / 8 - i * 0.9);
    if (a < 0) a = 0;
    dot[i].SetOpacity(0.25 + 0.75 * a);
  }
}
Plymouth.SetRefreshFunction(refresh_cb);

# ---- messages (e.g. "Starting NoCapOS") and the disk password prompt
msg = Sprite();
msg.SetPosition(0, bar_y + 26, 10);
fun message_cb(text) {
  img = Image.Text(text, 0.6, 0.63, 0.7);
  msg.SetImage(img);
  msg.SetX(Math.Int(Window.GetX() + sw / 2 - img.GetWidth() / 2));
}
Plymouth.SetMessageFunction(message_cb);

prompt = Sprite();
bullet_img = Image("bullet.png");
max_bullets = 24;
for (i = 0; i < max_bullets; i++) {
  bullet[i] = Sprite(bullet_img);
  bullet[i].SetOpacity(0);
}
fun password_cb(text, count) {
  p = Image.Text(text, 0.92, 0.93, 0.96);
  prompt.SetImage(p);
  prompt.SetPosition(Math.Int(Window.GetX() + sw / 2 - p.GetWidth() / 2), bar_y + 26, 11);
  prompt.SetOpacity(1);
  n = count;
  if (n > max_bullets) n = max_bullets;
  x0 = Math.Int(Window.GetX() + sw / 2 - n * 14 / 2);
  for (i = 0; i < max_bullets; i++) {
    bullet[i].SetPosition(x0 + i * 14, bar_y + 52, 11);
    bullet[i].SetOpacity(i < n);
  }
  msg.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(password_cb);

fun normal_cb() {
  prompt.SetOpacity(0);
  for (i = 0; i < max_bullets; i++) bullet[i].SetOpacity(0);
  msg.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_cb);

fun quit_cb() {
  fill.SetImage(fill_src.Scale(bar_w, bar_h));
}
Plymouth.SetQuitFunction(quit_cb);
