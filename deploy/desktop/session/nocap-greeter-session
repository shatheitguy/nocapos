#!/bin/sh
# NoCap Desktop's sign-in screen: greetd runs this as its greeter account.
# A labwc of its own (config in /usr/share/nocapos/greeter/labwc) shows
# only the NoCap sign-in screen; when someone signs in the greeter quits
# and labwc with it. Software rendering when the hardware path fails, so
# the sign-in screen always shows.

export XDG_CURRENT_DESKTOP=NoCap:wlroots
export XDG_SESSION_TYPE=wayland
export GDK_BACKEND=wayland
LIB=/usr/local/lib/nocapos/shell
CONF=/usr/share/nocapos/greeter/labwc
LABWC=labwc
if ! command -v labwc >/dev/null 2>&1 && [ -x "$LIB/labwc" ]; then LABWC="$LIB/labwc"; fi

run() {
  start=$(date +%s)
  if [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
    "$LABWC" -C "$CONF" -s "sh -c '$LIB/nocap-shell --greeter; $LABWC --exit'"
  else
    dbus-run-session -- "$LABWC" -C "$CONF" -s "sh -c '$LIB/nocap-shell --greeter; $LABWC --exit'"
  fi
  code=$?
  [ "$code" -ne 0 ] && [ $(($(date +%s) - start)) -lt 15 ] && return 1
  return 0
}

if [ -f /etc/nocapos/desktop-software-rendering ]; then export WLR_RENDERER=pixman; fi
run && exit 0
if [ "${WLR_RENDERER:-}" != pixman ]; then
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
  run && exit 0
fi
exit 1
