#!/bin/sh
# NoCap Desktop: the session greetd starts for whoever signs in (installed
# by NoCapOS to /usr/local/lib/nocapos/shell). labwc runs the windows; its
# autostart (/etc/xdg/labwc/autostart) brings up NoCap Shell.
#
# Safety net: when the compositor can't start on this graphics hardware (it
# ends within a few seconds), it's started again with software rendering,
# so the screen is never left black.

export XDG_CURRENT_DESKTOP=NoCap:wlroots
export XDG_SESSION_DESKTOP=nocap
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

LIB=/usr/local/lib/nocapos/shell
LABWC=labwc
if ! command -v labwc >/dev/null 2>&1 && [ -x "$LIB/labwc" ]; then LABWC="$LIB/labwc"; fi

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nocapos"
mkdir -p "$STATE" 2>/dev/null
LOG="$STATE/session.log"
[ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && mv -f "$LOG" "$LOG.old"

run() {
  start=$(date +%s)
  echo "== $(date) starting $LABWC ${WLR_RENDERER:+(renderer $WLR_RENDERER)}" >>"$LOG"
  if [ -n "$DBUS_SESSION_BUS_ADDRESS" ] || [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
    "$LABWC" >>"$LOG" 2>&1
  else
    dbus-run-session -- "$LABWC" >>"$LOG" 2>&1
  fi
  code=$?
  end=$(date +%s)
  # A quick, failed exit: the compositor didn't start.
  [ "$code" -ne 0 ] && [ $((end - start)) -lt 15 ] && return 1
  return 0
}

if [ -f /etc/nocapos/desktop-software-rendering ]; then export WLR_RENDERER=pixman; fi
run && exit 0
if [ "${WLR_RENDERER:-}" != pixman ]; then
  echo "== the compositor didn't start; trying software rendering" >>"$LOG"
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
  run && exit 0
fi
exit 1
