#!/bin/sh
# NoCap Desktop: the session greetd starts for whoever signs in (installed
# by NoCapOS to /usr/libexec/nocapos). Wayfire runs the windows with
# NoCap Desktop's own settings (/usr/share/nocapos/wayfire): real blur behind
# NoCap OS's glass and animated windows, like the web OS. Its autostart
# brings up NoCap Shell.
#
# Safety net: when Wayfire can't start on this graphics hardware (it ends
# within a few seconds), labwc runs the session instead
# (/usr/share/nocapos/labwc), and when that can't either, labwc with
# software rendering, so the screen is never left black. Software rendering
# (/etc/nocapos/desktop-software-rendering) and an explicit choice of labwc
# (/etc/nocapos/desktop-compositor) go straight to labwc.

export XDG_CURRENT_DESKTOP=NoCap:wlroots
export XDG_SESSION_DESKTOP=nocap
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
# No QT_QPA_PLATFORM: Qt 6 apps pick Wayland by themselves, and apps that
# refuse it (VLC 3 quits with "no suitable interface module") get X11.
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Never as root: the desktop is a person's own session.
if [ "$(id -u)" -eq 0 ]; then
  echo "nocap-session: refusing to run as root" >&2
  exit 1
fi

LIB=/usr/libexec/nocapos
CONF=/usr/share/nocapos/labwc
LABWC=labwc
if ! command -v labwc >/dev/null 2>&1 && [ -x "$LIB/labwc" ]; then LABWC="$LIB/labwc"; fi

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nocapos"
mkdir -p "$STATE" 2>/dev/null
# This person's window settings: NoCap Desktop's, with the title bar
# following Settings → title buttons (nocap-wm-style). The shared ones if
# that fails.
if "$LIB/nocap-wm-style" >/dev/null 2>&1 && [ -f "$STATE/labwc/rc.xml" ]; then CONF="$STATE/labwc"; fi
LOG="$STATE/session.log"
[ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && mv -f "$LOG" "$LOG.old"

WAYFIRE_CONF=/usr/share/nocapos/wayfire/wayfire.ini

# run COMPOSITOR ARGS...: the compositor until the session ends; fails when
# it ended within a few seconds (it couldn't start).
run() {
  start=$(date +%s)
  echo "== $(date) starting $1 ${WLR_RENDERER:+(renderer $WLR_RENDERER)}" >>"$LOG"
  if [ -n "$DBUS_SESSION_BUS_ADDRESS" ] || [ -S "${XDG_RUNTIME_DIR:-/nonexistent}/bus" ]; then
    "$@" >>"$LOG" 2>&1
  else
    dbus-run-session -- "$@" >>"$LOG" 2>&1
  fi
  code=$?
  end=$(date +%s)
  # The session's services end with it (the user manager outlives it).
  systemctl --user stop nocap-session.target graphical-session.target >/dev/null 2>&1
  # A quick, failed exit: the compositor didn't start.
  [ "$code" -ne 0 ] && [ $((end - start)) -lt 15 ] && return 1
  return 0
}

if [ -f /etc/nocapos/desktop-software-rendering ]; then export WLR_RENDERER=pixman; fi
# Wayfire draws with the graphics card only: not with software rendering.
if [ "${WLR_RENDERER:-}" != pixman ] && [ "$(cat /etc/nocapos/desktop-compositor 2>/dev/null)" != labwc ] &&
  command -v wayfire >/dev/null 2>&1 && [ -f "$WAYFIRE_CONF" ]; then
  # NoCap Shell's pages hear the screen blurs (glass stays see-through).
  export NOCAP_COMPOSITOR=wayfire
  run wayfire -c "$WAYFIRE_CONF" && exit 0
  echo "== Wayfire didn't start; NoCap Desktop runs on labwc" >>"$LOG"
  unset NOCAP_COMPOSITOR
fi
run "$LABWC" -C "$CONF" && exit 0
if [ "${WLR_RENDERER:-}" != pixman ]; then
  echo "== the compositor didn't start; trying software rendering" >>"$LOG"
  export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1
  run "$LABWC" -C "$CONF" && exit 0
fi
exit 1
