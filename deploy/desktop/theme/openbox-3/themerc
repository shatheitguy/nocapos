# NoCap: window decorations for NoCap Desktop (labwc), matching NoCap OS's
# own window chrome: dark title bars, the app's title on the left,
# minimize / maximize / close on the right, NoCap red for the close button
# and for focus. Written by NoCapOS; replaced on updates.

border.width: 1
padding.width: 10
padding.height: 11
corner.radius: 10

window.active.border.color: #2a2d36
window.inactive.border.color: #1c1e25
window.active.indicator.toggled-keybind.color: #e5383b

window.active.title.bg.color: #16181e
window.inactive.title.bg.color: #101217
window.active.label.text.color: #f2f3f5
window.inactive.label.text.color: #7c8190
window.label.text.justify: left

window.active.button.unpressed.image.color: #c9ccd3
window.inactive.button.unpressed.image.color: #5d6270
window.active.button.hover.image.color: #ffffff
window.active.button.close.unpressed.image.color: #ff6b6e
window.inactive.button.close.unpressed.image.color: #5d6270
window.active.button.close.hover.image.color: #ffffff
window.button.width: 30
window.button.spacing: 4
window.button.hover.bg.corner-radius: 8

window.active.shadow.size: 28
window.inactive.shadow.size: 16
window.active.shadow.color: #00000099
window.inactive.shadow.color: #00000066

menu.items.bg.color: #16181e
menu.items.text.color: #e8e9ec
menu.items.active.bg.color: #e5383b
menu.items.active.text.color: #ffffff
menu.items.padding.x: 12
menu.items.padding.y: 7
menu.separator.color: #2a2d36
menu.border.width: 1
menu.border.color: #2a2d36
menu.title.bg.color: #101217
menu.title.text.color: #ffffff
menu.title.text.justify: center

osd.bg.color: #16181e
osd.border.color: #2a2d36
osd.border.width: 1
osd.label.text.color: #f2f3f5
osd.window-switcher.width: 600
osd.window-switcher.padding: 8
osd.window-switcher.item.padding.x: 12
osd.window-switcher.item.padding.y: 8
osd.window-switcher.item.active.border.width: 2
osd.window-switcher.item.active.border.color: #e5383b

snapping.overlay.region.bg.enabled: yes
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.region.bg.color: #e5383b33
snapping.overlay.edge.bg.color: #e5383b33
