/* NoCapOS look for the graphical installer: near-black, NoCap red. */

QWidget {
  background-color: #0b0b10;
  color: #f2f2f5;
  selection-background-color: #e5383b;
  selection-color: #ffffff;
}

#mainApp {
  background-color: #0b0b10;
}

#sidebarApp,
#sidebarMenuApp {
  background-color: #050508;
}

QLabel {
  background: transparent;
}

QPushButton {
  background-color: #1c1c24;
  color: #f2f2f5;
  border: 1px solid #2c2c36;
  border-radius: 8px;
  padding: 6px 16px;
  min-height: 22px;
}

QPushButton:hover {
  border-color: #e5383b;
}

QPushButton:default,
#view-button-next,
#view-button-install {
  background-color: #e5383b;
  border-color: #e5383b;
  color: #ffffff;
}

QPushButton:disabled {
  background-color: #15151b;
  color: #6b6b76;
  border-color: #202028;
}

QLineEdit,
QComboBox,
QSpinBox,
QListView,
QTreeView,
QTableView,
QTextBrowser,
QPlainTextEdit {
  background-color: #14141b;
  color: #f2f2f5;
  border: 1px solid #2c2c36;
  border-radius: 6px;
  padding: 4px;
}

QLineEdit:focus,
QComboBox:focus {
  border-color: #e5383b;
}

QComboBox QAbstractItemView {
  background-color: #14141b;
  color: #f2f2f5;
  selection-background-color: #e5383b;
}

QRadioButton,
QCheckBox {
  background: transparent;
  spacing: 8px;
}

/* The choices themselves, clearly visible on the dark background. */
QRadioButton::indicator,
QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 2px solid #8a8a96;
  background-color: #14141b;
}

QRadioButton::indicator {
  border-radius: 9px;
}

QCheckBox::indicator {
  border-radius: 4px;
}

QRadioButton::indicator:hover,
QCheckBox::indicator:hover {
  border-color: #e5383b;
}

QRadioButton::indicator:checked {
  border-color: #e5383b;
  background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
    stop: 0 #e5383b, stop: 0.55 #e5383b, stop: 0.65 #14141b, stop: 1 #14141b);
}

QCheckBox::indicator:checked {
  border-color: #e5383b;
  background-color: #e5383b;
}

QRadioButton::indicator:disabled,
QCheckBox::indicator:disabled {
  border-color: #3a3a44;
}

/* The disk legend under the partition bars writes its names in dark text:
   it sits on a light panel so they stay readable. */
PartitionLabelsView {
  background-color: #d9d9e0;
  border-radius: 6px;
}

QProgressBar {
  background-color: #1c1c24;
  border: none;
  border-radius: 4px;
  height: 8px;
  text-align: center;
  color: #f2f2f5;
}

QProgressBar::chunk {
  background-color: #e5383b;
  border-radius: 4px;
}

QScrollBar:vertical {
  background: #0b0b10;
  width: 10px;
}

QScrollBar::handle:vertical {
  background: #2c2c36;
  border-radius: 5px;
  min-height: 24px;
}

/* Questions and messages: an outline, so they stand out from the page
   behind them (they have no title bar on the setup screen). */
QMessageBox,
QDialog {
  border: 1px solid #3a3a44;
}

QToolTip {
  background-color: #1c1c24;
  color: #f2f2f5;
  border: 1px solid #e5383b;
}
