#!/bin/sh
# Runs at sign-in in the ISO's live session: opens the installer once (the
# first sign-in of this session). "Install NoCapOS" is in the launcher too.
set -u
LIVE=/usr/lib/nocapos/image/live
seen="${XDG_RUNTIME_DIR:-/tmp}/nocapos-installer-opened"
[ -e "$seen" ] && exit 0
: >"$seen"
sleep 4
exec "$LIVE/nocapos-install"
