#!/bin/sh
# The full-screen NoCapOS setup, straight from the USB stick before any
# desktop starts (boot menu "Install NoCapOS", kernel option
# nocapos.install). greetd runs it as root in place of the sign-in screen:
# a kiosk compositor (cage) with only the installer on the whole screen.
#
# Drawing: with the processor (software rendering) first. Setup doesn't
# need the graphics hardware, and software rendering draws the same on
# every PC (no leftover or garbled areas from a graphics driver). The
# whole screen is redrawn on every change for the same reason.
#
# Safety net, so setup always shows:
#  1. software rendering;
#  2. when that ends within seconds, graphics hardware rendering;
#  3. when that ends quickly too, the "Try NoCapOS" desktop starts instead
#     and opens setup there.
# Closing the installer brings it back (after an install: the computer
# restarts into NoCapOS; after an install that didn't finish, the screen
# says so first). When it stops unexpectedly (it crashed), the
# screen says so before setup starts again.
#
# Logs: /var/log/nocapos (install-screen.log, the installer's own log of
# every run). The installer copies them into the installed system
# (save-setup-logs), so they're there after the restart too.
# /run/nocapos/install-screen.log points at the same file.
set -u
LIVE=/usr/lib/nocapos/image/live
STATE=/run/nocapos
LOGDIR=/var/log/nocapos
LOG=$LOGDIR/install-screen.log
RC=$STATE/setup-exit-code

# Inside the compositor: the installer itself, with its exit code kept for
# the loop below (cage's own code can't tell a crash from a close).
if [ "${1:-}" = --setup ]; then
  # -D6: the installer's log on its output too (it also keeps it in
  # ~/.cache/calamares/session.log). Higher levels add a debug button.
  # -stylesheet: NoCapOS's look on every window, the installer's own
  # messages too (they're separate windows, outside its main window).
  calamares -D6 -stylesheet /etc/calamares/branding/nocapos/stylesheet.qss
  rc=$?
  echo "$rc" >"$RC"
  exit "$rc"
fi

mkdir -p "$STATE" "$LOGDIR"
ln -sf "$LOG" "$STATE/install-screen.log"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
export QT_QPA_PLATFORM=wayland
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export XCURSOR_SIZE=24
# The installer's windows (its questions and messages too) without title
# bars of their own: the compositor places them, nothing to drag or resize.
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Safe drawing on any graphics hardware: the pointer drawn with the
# picture (no cursor plane), the screen always composed (never handed to
# the installer's buffer directly), and every frame drawn in full (no
# stale areas left from an earlier frame).
export WLR_NO_HARDWARE_CURSORS=1
export WLR_SCENE_DISABLE_DIRECT_SCANOUT=1
export WLR_SCENE_DEBUG_DAMAGE=rerender

software() {
  export WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1 QT_QUICK_BACKEND=software
  unset WLR_RENDERER_ALLOW_SOFTWARE
}
hardware() {
  unset WLR_RENDERER LIBGL_ALWAYS_SOFTWARE QT_QUICK_BACKEND
  export WLR_RENDERER_ALLOW_SOFTWARE=1
}

# Keep each run's own installer log (a new run starts a new one).
runs=0
keep_session_log() {
  for f in "${HOME:-/root}/.cache/calamares/session.log" /root/.cache/calamares/session.log; do
    if [ -s "$f" ]; then
      runs=$((runs + 1))
      cp -f "$f" "$LOGDIR/setup-run-$runs.log" 2>/dev/null
      return
    fi
  done
}

# A few lines on the screen (the text console under setup) between two
# starts of setup, for a few seconds.
say() {
  tty=/dev/tty1
  [ -w "$tty" ] || return 0
  setfont -C "$tty" Lat15-TerminusBold32x16 >/dev/null 2>&1 ||
    setfont -C "$tty" Lat15-Terminus32x16 >/dev/null 2>&1 || true
  printf 'c[?25l

' >"$tty" 2>/dev/null
  for line in "$@"; do printf '  %s
' "$line" >"$tty" 2>/dev/null; done
  sleep 8
  printf 'c[?25l' >"$tty" 2>/dev/null
}

# One start of the setup screen. 0: it was on the screen and closed (or
# setup finished); 1: it was on the screen and stopped unexpectedly; 2: it
# ended within seconds (it couldn't show on this screen).
show() {
  start=$(date +%s)
  rm -f "$RC" "$STATE/setup-installing"
  echo "== $(date) setup screen, $1 rendering" >>"$LOG"
  # -s: switching to a text console stays possible (Ctrl+Alt+F2).
  # -d: no title bars on the installer's windows.
  cage -s -d -- "$0" --setup >>"$LOG" 2>&1
  code=$?
  took=$(($(date +%s) - start))
  rc=$(cat "$RC" 2>/dev/null || echo none)
  echo "== ended after $took s (compositor $code, installer $rc)" >>"$LOG"
  keep_session_log
  [ "$took" -ge 20 ] || return 2
  [ "$rc" = 0 ] && return 0
  return 1
}

trap 'exit 0' TERM HUP INT

mode=software
quick=0
while :; do
  "$mode"
  show "$mode"
  case $? in
    0)
      quick=0
      # Closed after NoCapOS was installed (without restarting): restart
      # into it now; there's nothing else to do here.
      if [ -e "$STATE/setup-installed" ]; then
        echo "== $(date) NoCapOS is installed; restarting" >>"$LOG"
        say "NoCapOS is installed." "The computer restarts into it in a few seconds."
        systemctl reboot >>"$LOG" 2>&1
        sleep 30
      fi
      # Closed after an install that didn't finish (the installer said
      # why): say so, then setup starts over.
      if [ -e "$STATE/setup-installing" ]; then
        rm -f "$STATE/setup-installing"
        echo "== $(date) the install didn't finish; starting setup again" >>"$LOG"
        say "NoCapOS setup didn't finish installing." "It starts again in a few seconds." "Choose Install again to try once more."
      fi
      continue
      ;;
    1)
      quick=0
      echo "== $(date) setup stopped unexpectedly; starting it again" >>"$LOG"
      say "NoCapOS setup stopped unexpectedly." "It starts again in a few seconds." "If it was installing, choose Install again."
      continue
      ;;
  esac
  quick=$((quick + 1))
  if [ "$mode" = software ]; then
    mode=hardware
    quick=0
    continue
  fi
  [ "$quick" -ge 2 ] && break
done

# Setup can't show on its own on this screen: the "Try NoCapOS" desktop
# starts instead (it opens setup once it's up).
echo "== $(date) setup screen can't start here; starting the desktop" >>"$LOG"
if [ -f /etc/greetd/config-try.toml ]; then
  cat /etc/greetd/config-try.toml >/etc/greetd/config.toml
  systemd-run --no-block --collect systemctl restart greetd.service >>"$LOG" 2>&1 ||
    systemctl --no-block restart greetd.service >>"$LOG" 2>&1
fi
# Keep greetd's screen still until the restart takes over.
sleep 30
