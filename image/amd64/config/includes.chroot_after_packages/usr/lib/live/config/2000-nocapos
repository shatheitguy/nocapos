#!/bin/sh
# live-config component (runs at every start of the ISO's live session,
# after the live user is set up): NoCap Desktop signs the live user in
# straight away, with the "Install NoCapOS" app in the launcher, opened
# once on the first sign-in. Everything here lives in the live session's
# memory only; the installers copy the image itself, never these changes.
set -u
LIVE=/usr/lib/nocapos/image/live

user=nocap
for p in $(cat /proc/cmdline); do
  case "$p" in live-config.username=* | username=*) user="${p#*username=}" ;; esac
done

# The launcher (NoCap OS lists the machine's apps from here).
install -m 0644 "$LIVE/nocapos-install.desktop" /usr/share/applications/nocapos-install.desktop
# Debian's own launcher for the same installer stays out of sight.
mkdir -p /usr/local/share/applications
if [ -f /usr/share/applications/calamares-install-debian.desktop ]; then
  sed -e '/^NoDisplay=/d' -e 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' \
    /usr/share/applications/calamares-install-debian.desktop >/usr/local/share/applications/calamares-install-debian.desktop
fi

# "Install NoCapOS" in the boot menu (nocapos.install): the full-screen
# setup starts before any desktop, in place of the sign-in screen, and comes
# back if it's closed. Nothing else of the live session is set up.
case " $(cat /proc/cmdline) " in
  *" nocapos.install "*)
    if [ -f /etc/greetd/config.toml ]; then
      cat >/etc/greetd/config.toml <<TOML
# NoCapOS setup from the USB stick (written by the live session): the
# installer on the whole screen, no desktop.
[terminal]
vt = 1

[default_session]
command = "$LIVE/nocapos-install-screen"
user = "root"
TOML
    fi
    exit 0
    ;;
esac

# "Try NoCapOS": the live desktop; the installer opens once, at sign-in.
mkdir -p /etc/xdg/autostart
cat >/etc/xdg/autostart/nocapos-live-welcome.desktop <<DESKTOP
[Desktop Entry]
Type=Application
Name=Install NoCapOS
Exec=$LIVE/live-welcome
NoDisplay=true
DESKTOP

# NoCap Desktop signs the live user in without the sign-in screen (greetd's
# initial session, once per boot), and never locks the live session.
if id "$user" >/dev/null 2>&1 && [ -f /etc/greetd/config.toml ] && ! grep -q '^\[initial_session\]' /etc/greetd/config.toml; then
  printf '\n[initial_session]\ncommand = "/usr/libexec/nocapos/nocap-session"\nuser = "%s"\n' "$user" >>/etc/greetd/config.toml
fi
mkdir -p /etc/systemd/user
ln -sf /dev/null /etc/systemd/user/nocap-idle.service
exit 0
