# NoCapOS image: what the NoCapOS layer needs from Debian. The host
# packages (virtual machines, Samba, media, ZFS, Docker) are added by
# host-packages.sh during the build, so the first boot downloads nothing.
ca-certificates
curl
sudo
openssh-server
avahi-daemon
libnss-mdns
smartmontools
unattended-upgrades
apt-listchanges
plymouth
plymouth-themes
initramfs-tools
grub-common
locales
console-setup
keyboard-configuration
network-manager
firmware-linux-free
rsync
cryptsetup
