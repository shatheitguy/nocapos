<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/orbitron_bold"
        android:letterSpacing="0.2"
        android:textColor="#FF959AA5"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/rajdhani_bold"
            android:maxLines="1"
            android:textColor="#FFECEEF2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/w_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:fontFamily="@font/rajdhani_bold"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFF6A6A"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView android:id="@+id/w_cpu" style="@style/WidgetMeterLabel" />
    <ProgressBar android:id="@+id/w_cpu_bar" style="@style/WidgetMeter" />
    <TextView android:id="@+id/w_ram" style="@style/WidgetMeterLabel" />
    <ProgressBar android:id="@+id/w_ram_bar" style="@style/WidgetMeter" />
    <TextView android:id="@+id/w_disk" style="@style/WidgetMeterLabel" />
    <ProgressBar android:id="@+id/w_disk_bar" style="@style/WidgetMeter" />
</LinearLayout>
