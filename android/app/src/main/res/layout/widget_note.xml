<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass">

    <ImageView
        android:id="@+id/w_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_note_tint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/orbitron_bold"
            android:letterSpacing="0.2"
            android:textColor="#FFB4B9C3"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/rajdhani_bold"
            android:maxLines="2"
            android:textColor="#FFF4F5F8"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/w_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/rajdhani_medium"
            android:lineSpacingExtra="1dp"
            android:textColor="#FFDCDFE5"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
