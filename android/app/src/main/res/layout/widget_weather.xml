<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/w_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/w_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/orbitron_bold"
        android:maxLines="1"
        android:text="--°"
        android:textColor="#FFECEEF2"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/rajdhani_bold"
            android:maxLines="1"
            android:textColor="#FFECEEF2"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/rajdhani_semibold"
            android:maxLines="1"
            android:textColor="#FF959AA5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_hilo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_semibold"
            android:maxLines="1"
            android:textColor="#FFFF2A2A"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
