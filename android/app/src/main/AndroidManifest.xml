<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talks to your NoCapOS server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for scanning the pairing QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- "Unlinked", "download saved" and (opt-in) your server's notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Set as my phone's wallpaper too". -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Swipe down on the home screen opens the notification shade. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Long-press an app → Uninstall (Android still asks you). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Weather widget: rough location, only if you allow it (otherwise pick a city). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar widget, only if you allow it. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Quick toggles widget: Do not disturb (you allow it in Android's settings) and Wi-Fi/Bluetooth on/off state. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Timer widget: "ring with the clock app". -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <queries>
        <!-- The launcher lists every app that has a launcher icon. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Voice input for NoCap AI. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- Opening a file from your server in a phone app. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".NoCapApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoCap">

        <!-- Home screen + launcher + nocap://pair links. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nocap" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- The web desktop, in its own task so it stays signed in while
             you're on the home screen. -->
        <activity
            android:name=".desktop.DesktopActivity"
            android:exported="false"
            android:label="@string/desktop_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.nocap.link.desktop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />

        <!-- NoCap AI: chats with your server's AI Assistant. -->
        <activity
            android:name=".ai.AiActivity"
            android:exported="false"
            android:label="@string/ai_label"
            android:taskAffinity="com.nocap.link.ai"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Send to NoCap" in the share sheet. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:icon="@mipmap/ic_launcher"
            android:excludeFromRecents="true"
            android:taskAffinity="com.nocap.link.share"
            android:theme="@style/Theme.NoCap.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Opening server files in other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- "Ask NoCap AI" widget for any home screen. -->
        <receiver
            android:name=".widget.AskWidget"
            android:exported="false"
            android:label="@string/ai_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ask" />
        </receiver>

        <!-- NoCap OS widgets for any home screen. -->
        <receiver android:name=".widget.ClockAppWidget" android:exported="false" android:label="@string/w_clock">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_clock" />
        </receiver>
        <receiver android:name=".widget.WeatherAppWidget" android:exported="false" android:label="@string/w_weather">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_weather" />
        </receiver>
        <receiver android:name=".widget.StatusAppWidget" android:exported="false" android:label="@string/w_status">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_status" />
        </receiver>
        <receiver android:name=".widget.LinkAppWidget" android:exported="false" android:label="@string/w_link">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_link" />
        </receiver>
        <receiver android:name=".widget.SearchAppWidget" android:exported="false" android:label="@string/w_search">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/appwidget_search" />
        </receiver>

        <!-- In-app timer finished (when not handed to the clock app). -->
        <receiver android:name=".nocap.TimerReceiver" android:exported="false" />

        <!-- "Send clipboard to NoCap": quick-settings tile + a see-through moment in front. -->
        <service
            android:name=".sync.ClipTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_fg"
            android:label="@string/clip_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <activity
            android:name=".sync.ClipActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.nocap.link.clip"
            android:theme="@style/Theme.NoCap.Sheet" />

        <!-- "Not you? Sign it out" from a sign-in alert: a confirm over whatever is open. -->
        <activity
            android:name=".sync.SignOutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.nocap.link.signout"
            android:theme="@style/Theme.NoCap.Sheet" />

        <!-- Notification dots (opt-in: only after you allow notification access). -->
        <service
            android:name=".system.DotsService"
            android:exported="true"
            android:label="@string/dots_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Double-tap to lock (opt-in), Android 9+. -->
        <service
            android:name=".system.LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- Double-tap to lock (opt-in), older phones. -->
        <receiver
            android:name=".system.LockAdmin"
            android:exported="true"
            android:label="@string/lock_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/lock_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
